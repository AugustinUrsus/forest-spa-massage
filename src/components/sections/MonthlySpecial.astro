---
import { Coins, Sunrise, Check, CalendarHeart, Sparkles } from 'lucide-react';
import { monthlySpecial, standingOffers, baseUrl } from '../../data/siteData';

const offerIcons = { Coins, Sunrise } as const;
---

<section id="specials" class="bg-charcoal text-sand py-[var(--spacing-section)]">
  <div class="container-px reveal">
    <!-- Header -->
    <div class="max-w-2xl">
      <p class="eyebrow mb-4 text-gold">{monthlySpecial.month} · Limited Time</p>
      <h2 class="display-heading text-3xl sm:text-4xl lg:text-5xl">
        {monthlySpecial.headline}
      </h2>
    </div>

    <!-- Feature cards grid -->
    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      {
        monthlySpecial.items.map((item) => (
          <div class="flex flex-col justify-between rounded-[var(--radius-card)] border border-gold/30 bg-charcoal-deep/60 p-7 sm:p-9 lg:p-10 transition-all duration-300 hover:border-gold/50 shadow-lg">
            <div>
              {item.badge && (
                <div class="mb-4 inline-flex items-center gap-1.5 rounded-full border border-gold/40 bg-gold/15 px-3 py-1 text-xs font-semibold text-gold">
                  <Sparkles size={13} />
                  <span>{item.badge}</span>
                </div>
              )}

              <h3 class="display-heading text-2xl sm:text-3xl leading-snug text-sand">
                {item.name}
              </h3>

              <!-- Price row -->
              <div class="mt-5 flex flex-wrap items-end gap-x-3 gap-y-2">
                <span class="text-3xl sm:text-4xl font-semibold leading-none text-gold">
                  ${item.price}
                </span>
                <span class="text-base sm:text-lg leading-none text-sand/50 line-through">
                  ${item.value}
                </span>
                <span class="inline-flex items-center rounded-full bg-gold px-2.5 py-0.5 text-xs font-semibold text-charcoal">
                  Save ${item.value - item.price}
                </span>
                <span class="text-xs sm:text-sm text-sand/70">· {item.duration}</span>
              </div>

              <p class="mt-5 text-sm sm:text-base leading-relaxed text-sand/80">
                {item.summary}
              </p>

              <!-- Inclusions checklist -->
              <div class="mt-6 border-t border-sand/10 pt-5">
                <p class="eyebrow mb-3.5 text-xs text-gold">What's Included</p>
                <ul class="space-y-2.5 text-sm">
                  {item.inclusions.map((inclusion) => (
                    <li class="flex items-start gap-2.5">
                      <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-gold/15 text-gold">
                        <Check size={13} strokeWidth={2.2} />
                      </span>
                      <span class="text-sand/90 leading-snug">{inclusion}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-8 pt-5 border-t border-sand/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <a
                href={item.url}
                target="_blank"
                rel="noopener"
                data-book="monthly-special"
                class="btn btn-on-dark w-full sm:w-auto"
              >
                <CalendarHeart size={18} strokeWidth={1.6} /> Book This Special
              </a>
              <span class="text-xs text-sand/60">{monthlySpecial.validity}</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Educational Journal Link -->
    <div class="mt-8 text-center sm:text-left">
      <a
        href={`${baseUrl}journal/deep-tissue-vs-swedish`}
        class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-gold hover:text-gold/80 hover:underline"
      >
        Read Swedish vs. Deep Tissue Massage Guide →
      </a>
    </div>

    <!-- Standing offers -->
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        standingOffers.map((offer) => {
          const Icon = offerIcons[offer.icon];
          return (
            <div class="rounded-[var(--radius-card)] border border-sand/10 bg-charcoal-deep/40 p-7">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-sand/10 text-gold">
                <Icon size={22} strokeWidth={1.6} />
              </span>
              <h3 class="display-heading mt-5 text-lg text-sand">{offer.title}</h3>
              <p class="mt-2 leading-relaxed text-sand/80">{offer.description}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
