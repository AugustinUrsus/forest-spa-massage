---
import { serviceCategories, bookingUrl, baseUrl } from '../../data/siteData';
import ServiceTabs from '../react/ServiceTabs.tsx';

// Attach the exact Fresha deep link and rich metadata to each service before handing off to the island.
const categories = serviceCategories.map((c) => ({
  id: c.id,
  label: c.label,
  blurb: c.blurb,
  services: c.services.map((s) => ({
    name: s.name,
    id: s.id,
    priceLabel: s.priceLabel,
    inSessionPrice: s.inSessionPrice ?? null,
    duration: s.duration,
    description: s.description,
    href: s.url ?? bookingUrl(s.id),
    highlights: s.highlights ?? [],
    idealFor: s.idealFor ?? undefined,
    whatToExpect: s.whatToExpect ?? undefined,
    articleUrl: s.articleSlug ? `${baseUrl}journal/${s.articleSlug}` : undefined,
  })),
}));
---

<section id="services" class="bg-sand-deep pt-4 sm:pt-12 pb-16 sm:py-[var(--spacing-section)]">
  <div class="container-px reveal">
    <header class="mx-auto mb-4 sm:mb-8 max-w-2xl text-center">
      <p class="eyebrow mb-1 sm:mb-2">Treatment Menu</p>
      <h2 class="display-heading text-2xl sm:text-4xl lg:text-5xl">Massage & Scalp Therapies</h2>
    </header>

    <ServiceTabs client:visible categories={categories} />
  </div>
</section>
