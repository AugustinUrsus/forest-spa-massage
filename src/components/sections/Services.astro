---
import { serviceCategories, bookingUrl, baseUrl } from '../../data/siteData';
import ServiceTabs from '../react/ServiceTabs.tsx';
import { Compass, ArrowRight } from 'lucide-react';

// Attach the exact Fresha deep link and rich metadata to each service before handing off to the island.
const categories = serviceCategories.map((c) => ({
  id: c.id,
  label: c.label,
  blurb: c.blurb,
  services: c.services.map((s) => ({
    name: s.name,
    id: s.id,
    priceLabel: s.priceLabel,
    inSessionPrice: s.inSessionPrice ?? null,
    duration: s.duration,
    description: s.description,
    href: s.url ?? bookingUrl(s.id),
    highlights: s.highlights ?? [],
    idealFor: s.idealFor ?? undefined,
    whatToExpect: s.whatToExpect ?? undefined,
    articleUrl: s.articleSlug ? `${baseUrl}journal/${s.articleSlug}` : undefined,
  })),
}));
---

<section id="services" class="bg-sand-deep py-[var(--spacing-section)]">
  <div class="container-px reveal">
    <header class="mx-auto mb-10 max-w-2xl text-center">
      <p class="eyebrow mb-4">The Menu</p>
      <h2 class="display-heading text-3xl sm:text-4xl lg:text-5xl">Every Therapy, À La Carte</h2>
      <p class="mt-5 text-lg text-ink-soft">
        Book any treatment on its own, or add a finishing touch to your session. Tap a
        service to reserve it directly, or expand details to explore benefits and guides.
      </p>
    </header>

    <!-- Interactive Treatment Quiz recommendation callout -->
    <div class="mx-auto mb-12 max-w-2xl">
      <a
        href={`${baseUrl}quiz`}
        class="group flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 rounded-2xl border border-bronze/20 bg-cloud/80 p-4 sm:p-5 shadow-sm transition-all duration-300 hover:border-bronze hover:bg-cloud hover:shadow-md"
      >
        <div class="flex items-center gap-3.5">
          <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sage/15 text-sage-deep">
            <Compass size={22} strokeWidth={1.8} />
          </span>
          <div>
            <p class="text-sm font-semibold text-ink group-hover:text-bronze transition-colors">
              Not sure which treatment suits your body today?
            </p>
            <p class="text-xs text-ink-soft">Take our 60-second Treatment Quiz for personalized recommendations</p>
          </div>
        </div>
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-bronze whitespace-nowrap shrink-0 sm:self-center">
          Find My Treatment <ArrowRight size={14} className="transition-transform duration-300 group-hover:translate-x-1" />
        </span>
      </a>
    </div>

    <ServiceTabs client:visible categories={categories} />
  </div>
</section>
