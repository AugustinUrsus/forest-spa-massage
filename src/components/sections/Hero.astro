---
import { Image } from 'astro:assets';
import { CalendarHeart, ArrowDown, Gift } from 'lucide-react';
import { business, booking } from '../../data/siteData';
import { photos } from '../../data/photos';
---

<section
  id="top"
  class="relative flex min-h-[65svh] sm:min-h-[92svh] items-center overflow-hidden bg-charcoal text-sand"
>
  <!-- Background photo (LCP). On mobile the focal point shifts right so the
       candles show; text sits over the darkened left. -->
  <Image
    src={photos.heroAmbiance.src}
    alt={photos.heroAmbiance.alt}
    class="absolute inset-0 h-full w-full object-cover object-[64%_center] sm:object-center"
    widths={[768, 1280, 1920, 2600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <!-- Legibility overlays -->
  <div class="absolute inset-0 bg-gradient-to-r from-charcoal-deep/85 via-charcoal/65 to-charcoal/25"></div>
  <div class="absolute inset-x-0 bottom-0 h-16 sm:h-24 bg-gradient-to-b from-transparent to-sand-deep"></div>

  <div class="container-px relative z-10 pt-16 pb-8 sm:py-28 lg:py-32">
    <div class="max-w-2xl">
      <!-- Social Proof Trust Badge -->
      <div class="mb-2 sm:mb-4 flex items-center gap-2 text-xs font-medium text-gold/90">
        <span class="tracking-widest text-gold">★★★★★</span>
        <span>Rated Best Massage in Poway · 2026</span>
      </div>

      <p class="eyebrow mb-2 sm:mb-4 text-gold hidden sm:block">{business.tagline}</p>

      <h1 class="display-heading text-2xl sm:text-5xl lg:text-6xl leading-[1.15] sm:leading-[1.08]">
        {business.headline}
      </h1>

      <!-- Subhead: hidden on mobile, shown from sm up -->
      <p class="mt-4 sm:mt-6 hidden max-w-xl text-lg leading-relaxed text-sand/85 sm:block sm:text-xl">
        {business.subhead}
      </p>

      <!-- Primary Action Buttons -->
      <div class="mt-5 sm:mt-8 flex flex-wrap items-center gap-2.5 sm:gap-4">
        <a
          href={booking.primary}
          target="_blank"
          rel="noopener"
          data-book="hero"
          class="btn btn-primary shadow-md hover:shadow-lg"
        >
          <CalendarHeart size={18} /> Book Appointment
        </a>
        <a href="#services" class="btn btn-ghost-dark">
          Explore Services <ArrowDown size={16} />
        </a>
        <a
          href={booking.giftCards}
          target="_blank"
          rel="noopener"
          data-book="hero-giftcard"
          class="btn btn-ghost-dark hidden sm:inline-flex"
        >
          <Gift size={17} /> Gift Cards
        </a>
      </div>
    </div>
  </div>
</section>
