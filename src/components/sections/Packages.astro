---
import { packages, bookingUrl, baseUrl } from '../../data/siteData';
import PackageSelector from '../react/PackageSelector.tsx';
import { Compass } from 'lucide-react';

// Precompute each tier's Fresha deep link before handing off to the island.
const data = packages.map((p) => ({
  name: p.name,
  icon: p.icon,
  blurb: p.blurb,
  tiers: p.tiers.map((t) => ({
    tier: t.tier,
    price: t.price,
    value: t.value,
    duration: t.duration,
    inclusions: t.inclusions,
    href: t.url ?? bookingUrl(t.id),
  })),
}));
---

<section id="packages" class="bg-cloud py-[var(--spacing-section)]">
  <div class="container-px reveal">
    <header class="mx-auto mb-12 max-w-2xl text-center">
      <p class="eyebrow mb-4">Packages</p>
      <h2 class="display-heading text-3xl sm:text-4xl lg:text-5xl">Curated Ritual Packages</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">
        Every package comes in two or three tiers — choose your depth of escape, from a
        focused reset to our most complete head-to-toe retreat.
      </p>

      <div class="mt-6 flex justify-center">
        <a
          href={`${baseUrl}quiz`}
          class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-sand/40 px-4 py-2 text-xs font-semibold text-ink-soft transition-all duration-300 hover:border-bronze hover:bg-sand/70 hover:text-bronze"
        >
          <Compass size={14} className="text-sage-deep" />
          <span>Compare ritual packages via our 60-second Treatment Quiz →</span>
        </a>
      </div>
    </header>

    <PackageSelector client:visible packages={data} />
  </div>
</section>
