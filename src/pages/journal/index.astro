---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import StickyMobileBar from '../../components/sections/StickyMobileBar.astro';
import { articles } from '../../data/articles';
import { baseUrl } from '../../data/siteData';
import { Compass, Clock, ArrowRight, Sparkles } from 'lucide-react';

const featured = articles[0];
const remaining = articles.slice(1);
const allCategories = ['All Topics', ...Array.from(new Set(articles.map((a) => a.category)))];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://www.forestspamassage.com').href;
const homeUrl = new URL(baseUrl, Astro.site ?? 'https://www.forestspamassage.com').href;

const journalSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Forest Spa Wellness Journal',
    description:
      'Evidence-backed guides on scalp therapy, TMJ jaw tension, deep tissue recovery, and holistic bodywork from licensed therapists at Forest Spa in Poway, CA.',
    url: canonicalUrl,
    publisher: {
      '@type': 'DaySpa',
      name: 'Forest Spa',
      '@id': `${homeUrl}#business`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Forest Spa Wellness Journal',
    description:
      'Holistic living, massage science, and therapeutic wellness articles from Forest Spa Poway.',
    url: canonicalUrl,
    blogPost: articles.map((a) => ({
      '@type': 'BlogPosting',
      headline: a.title,
      description: a.metaDescription,
      url: new URL(`${baseUrl}journal/${a.slug}/`, Astro.site ?? 'https://www.forestspamassage.com').href,
      datePublished: a.isoDate,
      author: {
        '@type': 'Person',
        name: a.author.name,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: homeUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Wellness Journal',
        item: canonicalUrl,
      },
    ],
  },
];
---

<Layout
  title="Wellness Journal & Massage Guides | Forest Spa Poway"
  description="Evidence-backed guides on scalp therapy, TMJ jaw tension, deep tissue recovery, and holistic bodywork from licensed therapists at Forest Spa in Poway, CA."
  schemas={journalSchemas}
>
  <Header />

  <main id="main" class="bg-sand pb-[var(--spacing-section)] pt-28 sm:pt-36">
    <div class="container-px">
      <!-- Section Header -->
      <header class="mx-auto mb-10 max-w-3xl text-center">
        <p class="eyebrow mb-3">Holistic Living & Bodywork Wisdom</p>
        <h1 class="display-heading text-4xl sm:text-5xl lg:text-6xl text-ink">
          The Wellness Journal
        </h1>
        <p class="mt-5 text-base sm:text-lg leading-relaxed text-ink-soft">
          Mindful self-care, therapeutic science, and practical guides curated by our licensed massage therapists
          to help you unwind, recharge, and revive inside and outside our sanctuary.
        </p>

        <!-- Quiz quick jump -->
        <div class="mt-6 flex justify-center">
          <a
            href={`${baseUrl}quiz`}
            class="inline-flex items-center gap-2 rounded-full border border-bronze/30 bg-cloud/80 px-4 py-2 text-xs font-semibold text-bronze shadow-sm backdrop-blur transition-all duration-300 hover:border-bronze hover:bg-cloud hover:shadow"
          >
            <Compass size={15} className="text-sage" />
            <span>Unsure what treatment you need? Take our 60-second Quiz →</span>
          </a>
        </div>

        <!-- Category filter chips -->
        <div class="mt-8 flex flex-wrap justify-center gap-2" id="category-filters" role="group" aria-label="Filter articles by category">
          {
            allCategories.map((cat, idx) => (
              <button
                type="button"
                data-filter-btn={cat}
                class={`cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-semibold transition-all duration-200 ${
                  idx === 0
                    ? 'bg-bronze text-cream shadow-sm'
                    : 'bg-cloud/70 text-ink-soft hover:bg-cloud hover:text-bronze border border-black/5'
                }`}
              >
                {cat}
              </button>
            ))
          }
        </div>
      </header>

      <!-- Featured Story -->
      {
        featured && (
          <section id="featured-story-section" class="mb-14">
            <article data-category-card={featured.category} class="surface-card group overflow-hidden border border-black/10 transition-all duration-300 hover:shadow-xl">
              <div class="grid lg:grid-cols-12 lg:items-center">
                <div class="relative aspect-16/10 overflow-hidden bg-sand-deep lg:col-span-7 lg:aspect-auto lg:h-full">
                  <Image
                    src={featured.photo.src}
                    alt={featured.photo.alt}
                    width={900}
                    height={600}
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  />
                  <div class="absolute top-4 left-4 inline-flex items-center gap-1.5 rounded-full bg-charcoal/80 px-3 py-1 text-xs font-medium text-gold backdrop-blur">
                    <Sparkles size={13} /> Featured Story
                  </div>
                </div>

                <div class="flex flex-col justify-center p-7 sm:p-10 lg:col-span-5">
                  <div class="flex items-center gap-3 text-xs text-ink-soft/80">
                    <span class="rounded-full bg-sage/15 px-2.5 py-0.5 font-semibold text-sage-deep">
                      {featured.category}
                    </span>
                    <span>•</span>
                    <span class="inline-flex items-center gap-1">
                      <Clock size={13} /> {featured.readTime}
                    </span>
                  </div>

                  <h2 class="display-heading mt-4 text-2xl sm:text-3xl font-semibold leading-tight text-ink group-hover:text-bronze transition-colors">
                    <a href={`${baseUrl}journal/${featured.slug}`}>{featured.title}</a>
                  </h2>

                  <p class="mt-3 text-sm leading-relaxed text-ink-soft line-clamp-3">
                    {featured.excerpt}
                  </p>

                  <div class="mt-6 flex items-center justify-between border-t border-black/5 pt-5">
                    <span class="text-xs font-medium text-ink-soft">By {featured.author.name}</span>
                    <a
                      href={`${baseUrl}journal/${featured.slug}`}
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-bronze transition-colors hover:text-bronze-deep group-hover:underline"
                    >
                      Read Article <ArrowRight size={14} className="transition-transform group-hover:translate-x-1" />
                    </a>
                  </div>
                </div>
              </div>
            </article>
          </section>
        )
      }

      <!-- Articles Grid -->
      <section>
        <div class="mb-8 flex items-center justify-between border-b border-black/10 pb-4">
          <h2 class="display-heading text-xl font-semibold text-ink">All Wellness Articles</h2>
          <span class="text-xs text-ink-soft">{articles.length} Guides Available</span>
        </div>

        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            remaining.map((article) => (
              <article data-category-card={article.category} class="surface-card group flex h-full flex-col overflow-hidden border border-black/10 transition-all duration-300 hover:border-bronze/40 hover:shadow-lg">
                <a href={`${baseUrl}journal/${article.slug}`} class="block aspect-16/10 overflow-hidden bg-sand-deep">
                  <Image
                    src={article.photo.src}
                    alt={article.photo.alt}
                    width={600}
                    height={400}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </a>

                <div class="flex flex-1 flex-col p-6">
                  <div class="flex items-center gap-2 text-xs text-ink-soft/80">
                    <span class="rounded-full bg-sage/12 px-2.5 py-0.5 font-medium text-sage-deep">
                      {article.category}
                    </span>
                    <span>•</span>
                    <span class="inline-flex items-center gap-1">
                      <Clock size={12} /> {article.readTime}
                    </span>
                  </div>

                  <h3 class="display-heading mt-3 text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-bronze">
                    <a href={`${baseUrl}journal/${article.slug}`}>{article.title}</a>
                  </h3>

                  <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-ink-soft line-clamp-3">
                    {article.excerpt}
                  </p>

                  <div class="mt-auto flex items-center justify-between border-t border-black/5 pt-4">
                    <span class="text-[11px] text-ink-soft/70">{article.date}</span>
                    <a
                      href={`${baseUrl}journal/${article.slug}`}
                      class="inline-flex items-center gap-1 text-xs font-semibold text-bronze transition-colors hover:text-bronze-deep group-hover:underline"
                    >
                      Read Guide <ArrowRight size={13} className="transition-transform group-hover:translate-x-1" />
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Bottom quiz & explore banner -->
      <section class="mt-16 rounded-2xl border border-bronze/20 bg-cloud/90 p-8 sm:p-12 text-center shadow-sm">
        <h2 class="display-heading text-2xl sm:text-3xl font-semibold text-ink">
          Ready to experience total body renewal?
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-ink-soft">
          Take our quick 60-second quiz to discover the exact therapy customized to your body's current fatigue,
          or browse our à la carte services.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <a href={`${baseUrl}quiz`} class="btn btn-primary">
            <Compass size={18} /> Take Treatment Quiz
          </a>
          <a href={`${baseUrl}#services`} class="btn btn-outline">
            Browse Services
          </a>
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    const filterButtons = document.querySelectorAll('[data-filter-btn]');
    const cards = document.querySelectorAll('[data-category-card]');
    const featuredSection = document.getElementById('featured-story-section');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedCat = btn.getAttribute('data-filter-btn');

        filterButtons.forEach((b) => {
          b.classList.remove('bg-bronze', 'text-cream', 'shadow-sm');
          b.classList.add('bg-cloud/70', 'text-ink-soft', 'border', 'border-black/5');
        });
        btn.classList.remove('bg-cloud/70', 'text-ink-soft', 'border', 'border-black/5');
        btn.classList.add('bg-bronze', 'text-cream', 'shadow-sm');

        cards.forEach((card) => {
          const cat = card.getAttribute('data-category-card');
          if (selectedCat === 'All Topics' || cat === selectedCat) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        if (featuredSection) {
          const featuredCard = featuredSection.querySelector('[data-category-card]');
          if (featuredCard) {
            const cat = featuredCard.getAttribute('data-category-card');
            if (selectedCat === 'All Topics' || cat === selectedCat) {
              featuredSection.classList.remove('hidden');
            } else {
              featuredSection.classList.add('hidden');
            }
          }
        }
      });
    });
  </script>

  <Footer />
  <StickyMobileBar />
</Layout>
